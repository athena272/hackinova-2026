# Copie para .env.local (nunca commitar valores reais).
#
# --- Local (Docker) ---
# 1) Na raiz do monorepo: npx supabase start
# 2) Cole URL e service_role do CLI (ou `npx supabase status -o env`)
# 3) pnpm dev em app/agendacerta
#
# --- Vercel (produção) ---
# Em Project Settings → Environment Variables, use as keys do
# projeto Supabase CLOUD (Dashboard → Project Settings → API):
#   NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable ou anon>
#   SUPABASE_SERVICE_ROLE_KEY=<secret ou service_role>  ← obrigatório (não use a anon)
# Aplique as migrations no cloud antes do deploy (GitHub Integration
# ou `npx supabase db push` com link do projeto).
# Sem GRANT ao service_role na migration, a API retorna
# "permission denied for table appointments".

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sem essas vars, a API cai no repositório em memória (seed JSON).

# --- Login da clínica (Better Auth) ---
# Obrigatórias: sem elas o login fica indisponível e o painel não abre.
# Local: Postgres do `npx supabase start` (porta 54322).
# Vercel: Supabase → Connect → Transaction pooler (porta 6543), com a senha do banco.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Mínimo 32 caracteres. Gere com: openssl rand -base64 32
# Use um valor diferente em produção e nunca commite.
BETTER_AUTH_SECRET=
# URL pública do app. Local: http://localhost:3000. Vercel: https://<seu-app>.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# --- Script `pnpm auth:create-user` (cria o usuário da clínica) ---
# Cadastro público é desligado; o usuário só nasce por esse script.
CLINIC_USER_EMAIL=
CLINIC_USER_PASSWORD=
CLINIC_USER_NAME=Clínica Exemplo
