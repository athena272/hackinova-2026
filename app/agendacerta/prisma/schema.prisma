/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Patient {
  id              String                  @id
  fullName        String                  @map("full_name")
  phoneMasked     String                  @map("phone_masked")
  neighborhoodId  String?                 @map("neighborhood_id")
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)
  appointments    Appointment[]
  neighborhood    Neighborhood?           @relation(fields: [neighborhoodId], references: [id], onUpdate: NoAction)
  waitlistEntries WaitlistEntry[]
  duplicateChecks DuplicateBookingCheck[]

  @@index([neighborhoodId])
  @@map("patients")
}

