/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
/// Os índices únicos parciais (uma oferta pendente por vaga e por candidato) ficam só na migration.
/// Declarados aqui com @unique, o Prisma trataria a relação como 1:1, e uma vaga tem várias ofertas.
model SlotOffer {
  id             String            @id
  appointmentId  String            @map("appointment_id")
  waitlistId     String            @map("waitlist_id")
  status         slot_offer_status @default(pendente)
  offeredAt      DateTime          @map("offered_at") @db.Timestamptz(6)
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(6)
  closedAt       DateTime?         @map("closed_at") @db.Timestamptz(6)
  timeoutMinutes Int               @map("timeout_minutes") @db.SmallInt
  distanceKm     Decimal?          @map("distance_km") @db.Decimal(6, 2)
  releaseReason  slot_release_reason @default(cancelamento) @map("release_reason")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  appointment    Appointment       @relation(fields: [appointmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  candidate      WaitlistEntry     @relation(fields: [waitlistId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([appointmentId, offeredAt], map: "slot_offers_appointment_offered_at_idx")
  @@map("slot_offers")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
/// Os índices únicos parciais (número do encaixe por bloco e uma recusa por bloco) ficam só na migration.
model Overbooking {
  id                   String               @id
  anchorAppointmentId  String               @map("anchor_appointment_id")
  specialty            String
  scheduledAt          DateTime             @map("scheduled_at") @db.Timestamptz(6)
  decision             overbooking_decision
  sequence             Int?                 @db.SmallInt
  encaixeAppointmentId String?              @unique @map("encaixe_appointment_id")
  riskProbability      Int                  @map("risk_probability") @db.SmallInt
  decidedAt            DateTime             @map("decided_at") @db.Timestamptz(6)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  anchorAppointment    Appointment          @relation("OverbookingAnchor", fields: [anchorAppointmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  encaixeAppointment   Appointment?         @relation("OverbookingEncaixe", fields: [encaixeAppointmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([anchorAppointmentId], map: "overbookings_anchor_appointment_idx")
  @@map("overbookings")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
