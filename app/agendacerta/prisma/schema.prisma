generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Appointment {
  id                       String                             @id
  specialty                String
  scheduledAt              DateTime                           @map("scheduled_at") @db.Timestamptz(6)
  status                   appointment_status                 @default(pendente)
  createdAt                DateTime                           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                           @default(now()) @map("updated_at") @db.Timestamptz(6)
  patientId                String                             @map("patient_id")
  procedureType            procedure_type                     @default(consulta) @map("procedure_type")
  procedureName            String?                            @map("procedure_name")
  bookedAt                 DateTime                           @default(now()) @map("booked_at") @db.Timestamptz(6)
  preparationResult        preparation_result?                @map("preparation_result")
  preparationAnsweredAt    DateTime?                          @map("preparation_answered_at") @db.Timestamptz(6)
  preparationMissedItemIds String[]                           @default([]) @map("preparation_missed_item_ids")
  unitId                   String?                            @map("unit_id")
  returnOfAppointmentId    String?                            @map("return_of_appointment_id")
  patient                  Patient                            @relation(fields: [patientId], references: [id], onUpdate: NoAction)
  unit                     ClinicUnit?                        @relation(fields: [unitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  returnOf                 Appointment?                       @relation("AppointmentReturn", fields: [returnOfAppointmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  returns                  Appointment[]                      @relation("AppointmentReturn")
  slotOffers               SlotOffer[]
  anchoredOverbookings     Overbooking[]                      @relation("OverbookingAnchor")
  encaixeOverbooking       Overbooking?                       @relation("OverbookingEncaixe")
  duplicateCheckItems      DuplicateBookingCheckAppointment[]
  keptInDuplicateChecks    DuplicateBookingCheck[]

  @@index([scheduledAt])
  @@index([patientId])
  @@index([unitId])
  @@index([returnOfAppointmentId])
  @@map("appointments")
}

