  @@map("clinic_units")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
/// O índice único parcial (uma confirmação aguardando por grupo de horários) fica só na migration.
model DuplicateBookingCheck {
  id                String                             @id
  patientId         String                             @map("patient_id")
  groupKey          String                             @map("group_key")
  status            duplicate_check_status             @default(aguardando)
  keptAppointmentId String?                            @map("kept_appointment_id")
  sentAt            DateTime                           @map("sent_at") @db.Timestamptz(6)
  resolvedAt        DateTime?                          @map("resolved_at") @db.Timestamptz(6)
  createdAt         DateTime                           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                           @default(now()) @map("updated_at") @db.Timestamptz(6)
  patient           Patient                            @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  keptAppointment   Appointment?                       @relation(fields: [keptAppointmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items             DuplicateBookingCheckAppointment[]

  @@index([patientId], map: "duplicate_booking_checks_patient_idx")
  @@map("duplicate_booking_checks")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model DuplicateBookingCheckAppointment {
  checkId       String                @map("check_id")
  appointmentId String                @map("appointment_id")
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  check         DuplicateBookingCheck @relation(fields: [checkId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  appointment   Appointment           @relation(fields: [appointmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([checkId, appointmentId])
  @@index([appointmentId], map: "duplicate_booking_check_appointments_appointment_idx")
  @@map("duplicate_booking_check_appointments")
}

enum appointment_status {
  pendente
  confirmado
  liberado
  remarcacao_solicitada
  compareceu
  faltou
}

enum waitlist_status {
  aguardando
  atribuido
}

enum procedure_type {
  consulta
  exame
}

enum preparation_result {
  ok
  nao_cumprido
}

enum slot_offer_status {
  pendente
  aceita
  recusada
  expirada
}

enum slot_release_reason {
  cancelamento
  preparo
  booking_duplo
}

enum overbooking_decision {
  aceita
  recusada
}

enum duplicate_check_status {
  aguardando
  resolvida
}
